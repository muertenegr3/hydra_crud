spring.application.name=hydra_Crud

spring.datasource.url=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:5432/postgres
spring.datasource.username=TU_USUARIO_SUPABASE
spring.datasource.password=TU_PASSWORD_SUPABASE
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

spring.jpa.entity-scan.base-packages=com.example.hydra_Crud.app.Entity
spring.data.jpa.repositories.base-packages=com.example.hydra_Crud.app.Repository

server.port=${PORT:8080}
spring.jpa.hibernate.ddl-auto=none

# ==========================================
# SUPABASE STORAGE S3 (archivado de historiales)
# En Render se leen directo como variables de entorno
# (este application.properties esta gitignoreado y no viaja en el jar).
# ==========================================
supabase.s3.endpoint=${SUPABASE_S3_ENDPOINT}
supabase.s3.region=${SUPABASE_S3_REGION:us-west-2}
supabase.s3.access-key=${SUPABASE_S3_ACCESS_KEY}
supabase.s3.secret-key=${SUPABASE_S3_SECRET_KEY}
supabase.bucket=${SUPABASE_BUCKET:Pacientes}